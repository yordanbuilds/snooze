#!/usr/bin/env bash
# snooze-helper — the only writer of Snooze's managed block in /etc/hosts.
# Verbs:
#   block <until-epoch|0> <domain>...   write the block (0 = indefinite)
#   unblock                             remove the block
#   sweep                               remove the block only if it expired
#   version                             print helper version (no root needed)
# Installed root-owned to /usr/local/bin by `snooze setup`, with a narrow
# %wheel NOPASSWD sudoers rule. It writes 0.0.0.0 entries inside its own
# markers and nothing else — the worst a caller can do is block a site.
set -euo pipefail
# The domain grammar below is ASCII, and a bracket expression is only ASCII in
# the C locale: under en_US.UTF-8, [a-z] also matches é, so évil.com would pass
# the check the caller's jq mirror refuses. Pin it, whatever the caller's
# environment says.
export LC_ALL=C

VERSION=2
HOSTS=/etc/hosts
BEGIN='# >>> snooze >>>'
END='# <<< snooze <<<'
MAX_DOMAINS=500
DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'

die() { echo "snooze-helper: $1" >&2; exit 1; }

verb=${1:-}
[[ -n $verb ]] || die "usage: snooze-helper block|unblock|sweep|version"
shift
[[ $verb == version ]] && { echo "$VERSION"; exit 0; }

# Test seam: redirect writes to a scratch file. Refused as root, so the
# passwordless sudo path can only ever operate on the real /etc/hosts.
if [[ ${1:-} == --hosts-file ]]; then
  (( EUID != 0 )) || die "--hosts-file is refused as root"
  [[ -n ${2:-} ]] || die "--hosts-file needs a path"
  HOSTS=$2
  shift 2
elif (( EUID != 0 )); then
  die "must run as root (tests pass --hosts-file)"
fi

strip_block() { # reads $HOSTS twice: pass 1 records the last end marker; a begin
                # marker only opens a block when an end marker follows it below,
                # so a truncated block is left in place, never swallowed. Mirrors
                # hasEndAfter() in Model.mjs — an end marker sitting *above* the
                # begin marker must not re-arm the swallow either.
  awk -v b="$BEGIN" -v e="$END" '
    NR == FNR { if (index($0, e) == 1) last_end = FNR; next }
    index($0, b) == 1 && FNR < last_end { skip = 1; next }
    index($0, e) == 1 { skip = 0; next }
    !skip { print }' "$HOSTS" "$HOSTS"
}

drop_markers() { # strip_block deliberately keeps a truncated block's orphan
                 # begin marker and the lines under it. Before writing a fresh
                 # block, drop the marker lines themselves: an orphan begin left
                 # above the new block would be terminated by the new end marker,
                 # and the next strip would swallow everything between the two.
                 # Mirrors applyBlock() in Model.mjs.
  awk -v b="$BEGIN" -v e="$END" 'index($0, b) == 1 || index($0, e) == 1 { next } { print }'
}

current_until() { # empty when nothing is blocked. A begin marker only counts as
                  # a session when an end marker follows it — the same rule
                  # strip_block and Model.hasEndAfter apply, so an orphan marker
                  # is never read as a live block. Only the first block is read:
                  # a hand-duplicated marker cannot turn the epoch into
                  # arithmetic downstream.
  awk -v b="$BEGIN" -v e="$END" '
    NR == FNR { if (index($0, e) == 1) last_end = FNR; next }
    index($0, b) == 1 && FNR < last_end {
      if (match($0, /until=[0-9]+/)) print substr($0, RSTART + 6, RLENGTH - 6)
      exit
    }' "$HOSTS" "$HOSTS"
}

write_hosts() { # full new content on stdin; atomic rename, world-readable
  local tmp
  tmp=$(mktemp "$HOSTS.snooze.XXXXXX")
  cat >"$tmp"
  chmod 644 "$tmp"
  (( EUID != 0 )) || chown root:root "$tmp"
  mv -f "$tmp" "$HOSTS"
}

flush() {
  [[ $HOSTS == /etc/hosts ]] || return 0
  resolvectl flush-caches 2>/dev/null || true
}

case $verb in
  block)
    (( $# >= 2 )) || die "block needs <until> and at least one domain"
    until_at=$1
    shift
    [[ $until_at =~ ^[0-9]+$ ]] || die "until must be an epoch integer, or 0 for indefinite"
    (( $# <= MAX_DOMAINS )) || die "refusing more than $MAX_DOMAINS domains"
    for d in "$@"; do
      [[ ${#d} -le 253 && $d =~ $DOMAIN_RE ]] || die "invalid domain: $d"
    done
    rest=$(strip_block | drop_markers) # $() trims trailing newlines — no blank-line growth
    {
      printf '%s\n\n' "$rest"
      echo "$BEGIN until=$until_at"
      for d in "$@"; do echo "0.0.0.0 $d"; done
      echo "$END"
    } | write_hosts
    flush
    ;;
  unblock)
    # drop_markers as well as strip_block: strip_block deliberately keeps a
    # truncated block's orphan begin marker and everything under it, but
    # leaving the marker line leaves a phantom session behind — status reads
    # its until=, and unblock is exactly the command asked to end that.
    rest=$(strip_block | drop_markers)
    printf '%s\n' "$rest" | write_hosts
    flush
    ;;
  sweep)
    u=$(current_until)
    [[ -n $u && $u != 0 ]] || exit 0
    (( $(date +%s) >= u )) || exit 0
    rest=$(strip_block | drop_markers) # same convergence as unblock
    printf '%s\n' "$rest" | write_hosts
    flush
    ;;
  *) die "unknown verb: $verb" ;;
esac
